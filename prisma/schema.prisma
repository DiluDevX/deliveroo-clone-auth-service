generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                 @id @default(uuid())
  firstName                 String
  lastName                  String
  email                     String
  phone                     String?
  password                  String
  role                      Role                   @default(user)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  deletedAt                 DateTime?
  restaurantUsers           RestaurantUser[]
  refreshTokens             RefreshToken[]
  passwordResets            PasswordResetToken[]
  addresses                 Address[]
  restaurantInvitationsSent RestaurantInvitation[] @relation("RestaurantInvitationSender")
  restaurantOwnerships      RestaurantOwnership[]  @relation("RestaurantOwnershipOwner")
}

model Address {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  line1        String
  line2        String?
  city         String
  postcode     String
  country      String    @default("UK")
  latitude     Float?
  longitude    Float?
  instructions String?
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([userId])
}

model RestaurantUser {
  id           String         @id @default(uuid())
  role         RestaurantRole @default(employee)
  restaurantId String
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  @@index([restaurantId, deletedAt])
  @@index([userId, deletedAt])
}

model RestaurantOwnership {
  id             String                    @id @default(uuid())
  restaurantId   String                    @unique
  provisioningId String                    @unique
  ownerFirstName String
  ownerLastName  String
  ownerEmail     String                    @unique
  status         RestaurantOwnershipStatus @default(INVITED)
  invitationId   String                    @unique
  invitation     RestaurantInvitation      @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  ownerUserId    String?
  ownerUser      User?                     @relation("RestaurantOwnershipOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  acceptedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([status, updatedAt])
}

model RestaurantInvitation {
  id                  String               @id @default(uuid())
  email               String
  restaurantId        String
  role                RestaurantRole
  tokenHash           String               @unique
  invitedById         String
  invitedBy           User                 @relation("RestaurantInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  acceptedAt          DateTime?
  revokedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  restaurantOwnership RestaurantOwnership?

  @@index([restaurantId, email])
  @@index([email, acceptedAt, revokedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum Role {
  user
  platform_admin
  restaurant_user
}

enum RestaurantRole {
  employee
  super_admin
  admin
  finance
}

enum RestaurantOwnershipStatus {
  INVITED
  ACCEPTED
}
